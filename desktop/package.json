{
  "name": "device-rescue",
  "productName": "Reclaim City",
  "version": "0.3.7",
  "description": "Reclaim City desktop app",
  "author": "The Multiverse School",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "check-game-files": "node -e \"require('fs').existsSync('vendor/reclaim-city/src/components/scout.js') || (console.error('desktop/vendor/reclaim-city is empty. Run git submodule update --init.'), process.exit(1))\"",
    "predist": "npm run check-game-files",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "school.themultiverse.devicerescue",
    "productName": "Reclaim City",
    "files": [
      "main.js",
      "user-data.js",
      "preload.js",
      "engine-runner.js",
      "fix-policy.js",
      "mark-policy.js",
      "setting-urls.js",
      "mission-links.js",
      "mission-links.json",
      "ask-about.js",
      "ai-prompt.js",
      "renderer/**",
      "app-protocol.js",
      "recheck.js",
      "watch.js",
      "rc-files.json",
      "vendor/reclaim-city/src/components/**",
      "vendor/reclaim-city/src/data/**",
      "vendor/reclaim-city/src/screens/**",
      "vendor/reclaim-city/src/utils/**",
      "vendor/reclaim-city/src/state.js",
      "vendor/reclaim-city/src/router.js",
      "vendor/reclaim-city/src/style.css",
      "vendor/reclaim-city/src/assets/**"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "artifactName": "ReclaimCity-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Reclaim City"
    },
    "win": {
      "target": "nsis",
      "artifactName": "ReclaimCity-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Reclaim City"
    }
  },
  "devDependencies": {
    "electron": "^42.11.3",
    "electron-builder": "^26.15.3"
  }
}
